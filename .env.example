# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAAbbbCCCdddEEE
# ID Telegram-группы с включёнными темами (начинается с -100)
GROUP_ID=-1001234567890
# Порт, на котором работает чат (nginx проксирует на него)
PORT=3000
# С каких сайтов разрешены запросы (* = с любых)
ALLOWED_ORIGIN=*

# ---------- ИИ-ассистент (необязательно) ----------
# Без LLM_API_KEY чат работает как раньше, только с живыми ответами.
# Yandex AI Studio: API-ключ сервисного аккаунта (роль ai.languageModels.user) и ID каталога.
LLM_API_KEY=
LLM_FOLDER=
# Модель: yandexgpt-5.1 (YandexGPT Pro 5.1), aliceai-llm, aliceai-llm-flash (дешевле), qwen3.6-35b-a3b
LLM_MODEL=yandexgpt-5.1
# Адрес API, совместимого с OpenAI (менять только для другого провайдера)
# LLM_API_URL=https://llm.api.cloud.yandex.net/v1
# Через сколько часов молчания менеджера ассистент снова отвечает в диалоге (0 = только по команде /bot)
AI_RESUME_HOURS=12
# Максимум ответов ассистента одному посетителю в сутки
AI_MAX_PER_DAY=40
# Дублировать заявки в «Общую» тему группы (0 = только в теме посетителя)
LEADS_TO_GENERAL=1
