# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAAbbbCCCdddEEE
# ID Telegram-группы с включёнными темами (начинается с -100)
GROUP_ID=-1001234567890
# Порт, на котором работает чат (nginx проксирует на него)
PORT=3000
# С каких сайтов разрешены запросы (* = с любых)
ALLOWED_ORIGIN=*

# ---------- Бот-помощник (необязательно) ----------
# off — бот выключен, simple — простой бот без нейросети (бесплатно), ai — нейросеть
BOT_MODE=off
# Нейросеть: gemini (бесплатно), groq, openrouter, yandex
LLM_PROVIDER=gemini
LLM_API_KEY=
# Прокси для Gemini/Groq (тот же Cloudflare Worker, что и для Telegram, с новым кодом из README)
LLM_PROXY=
# Модель (если не указать, берётся по умолчанию для провайдера)
# LLM_MODEL=gemini-2.5-flash
# Только для YandexGPT: ID каталога
# LLM_FOLDER=
# Через сколько часов молчания менеджера бот снова отвечает в диалоге (0 = только по команде /bot)
AI_RESUME_HOURS=12
# Максимум ответов бота одному посетителю в сутки
AI_MAX_PER_DAY=40
# Дублировать заявки в «Общую» тему группы (0 = только в теме посетителя)
LEADS_TO_GENERAL=1
